        "https://www.sephora.es/*",
        "https://www.sephora.it/*"
      ],
      "js": [
        "inpage.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*"
      ],
      "matches": [
