        "https://www.sephora.co.uk/*",
        "https://www.sephora.de/*",
        "https://www.sephora.es/*",
        "https://www.sephora.it/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.amazon.com/*",
        "https://www.amazon.co.uk/*",
        "https://www.amazon.fr/*",
